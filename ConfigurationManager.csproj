    <PublicizedAssembliesPath Condition="'$(PublicizedAssembliesPath)' == ''">$(ManagedAssembliesPath)\publicized_assemblies</PublicizedAssembliesPath>
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
    <GamePluginPath Condition="'$(GamePluginPath)' == ''">$(BepInExPath)\plugins</GamePluginPath>
  </PropertyGroup>
