    <EnableReleasePackaging Condition="'$(EnableReleasePackaging)' == ''">true</EnableReleasePackaging>
    <BuildNexusPackage Condition="'$(BuildNexusPackage)' == ''">true</BuildNexusPackage>
    <NexusPackageArgument Condition="'$(BuildNexusPackage)' == 'true'">-CreateNexusPackage</NexusPackageArgument>
  </PropertyGroup>
  <PropertyGroup>
