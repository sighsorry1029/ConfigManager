  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="ValidateBuildEnvironment" BeforeTargets="ResolveReferences">
    <Error Condition="'$(ValheimGamePath)' == '' Or !Exists('$(ValheimGamePath)')" Text="Valheim installation was not found. Pass /p:ValheimGamePath=&quot;path-to-Valheim&quot;." />
    <Error Condition="!Exists('$(BepInExPath)\core\BepInEx.dll')" Text="BepInEx.dll was not found under $(BepInExPath)\core." />
    <Error Condition="!Exists('$(PublicizedAssembliesPath)\assembly_valheim_publicized.dll')" Text="Publicized Valheim assemblies were not found under $(PublicizedAssembliesPath)." />
    <Error Condition="!Exists('$(ManagedAssembliesPath)\UnityEngine.CoreModule.dll')" Text="Unity managed assemblies were not found under $(ManagedAssembliesPath)." />
  </Target>
  <Target Name="DeployDebugToGame"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' And '$(DeployToGame)' == 'true' And '$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(TargetPath)')" Text="Debug DLL was not found: $(TargetPath)" />
    <Message Importance="high" Text="Debug build succeeded. Copying $(TargetFileName) to $(GamePluginPath)." />
    <MakeDir Directories="$(GamePluginPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(GamePluginPath)\$(TargetFileName)" SkipUnchangedFiles="false" />
  </Target>
  <Target Name="PackageRelease"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' And '$(DesignTimeBuild)' != 'true' And '$(EnableReleasePackaging)' == 'true'">
    <Error Condition="!Exists('$(TargetPath)')" Text="Release DLL was not found: $(TargetPath)" />
    <Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\PackageRelease.ps1&quot; -ProjectRoot &quot;$(MSBuildProjectDirectory)&quot; -AssemblyPath &quot;$(TargetPath)&quot; $(NexusPackageArgument)" />
  </Target>
  <PropertyGroup>
    <PostBuildEvent>
    </PostBuildEvent>
  </PropertyGroup>
